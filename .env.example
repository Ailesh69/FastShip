# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=fastship
POSTGRES_TEST_DB=fastship_test

# --- Redis (token blacklist, delivery OTPs, Celery broker) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Public address of this API, including scheme ---
# Every emailed link (verification, password reset, tracking, review) and the
# fonts the emails load are built from this, so it must resolve on the
# RECIPIENT's device.
#
# Leave it as localhost and the server falls back to whatever Host each request
# arrived on, which covers the two easy cases automatically:
#
#   Same machine ......... works as-is.
#   Same Wi-Fi ........... start with `uvicorn main:app --host 0.0.0.0 --port 8000`
#                          and open the app on this machine's LAN IP
#                          (e.g. http://192.168.1.42:8000). Links generated from
#                          those requests point back at the LAN IP, so a phone
#                          on the same network can open them.
#   Another network ...... NOT POSSIBLE without a public address. Expose the
#                          server and pin it here:
#                              cloudflared tunnel --url http://localhost:8000
#                              ngrok http 8000
#                          then set, e.g.
#                              APP_BASE_URL=https://abcd-1234.trycloudflare.com
#                          A non-loopback value set here always wins over the
#                          request Host, so this is the switch for "real" use.
APP_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call this API. This is about the
# SPA, not about emailed links — a link opens a page served by this API and
# never trips CORS. But if you load the React app from another device you are
# loading it from a different origin, so add that one too, e.g.
#   CORS_ORIGINS=http://localhost:5173,http://192.168.1.42:5173
CORS_ORIGINS=http://localhost:5173

# --- Mail ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=FastShip
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# --- Twilio (delivery OTP SMS) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
